[Unit]
Description=ARKlinux Hardware Inventory Observer
After=local-fs.target systemd-tmpfiles-setup.service
PartOf=ark.target

[Service]
Type=simple
User=ark-hardwared
Group=ark-io
ExecStart=/usr/bin/python /usr/lib/ark/ark_native.py --role hardwared
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ark

[Install]
WantedBy=ark.target
