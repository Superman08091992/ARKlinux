[Unit]
Description=ARKlinux Constrained Desktop Privilege Broker
After=local-fs.target
Before=greetd.service

[Service]
Type=simple
User=root
Group=wheel
UMask=0007
RuntimeDirectory=ark-desktop
RuntimeDirectoryMode=0770
LogsDirectory=ark-desktop
LogsDirectoryMode=0750
ExecStart=/usr/bin/python /usr/lib/ark-desktop/ark-rootd.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/ark-desktop /var/log/ark-desktop
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
