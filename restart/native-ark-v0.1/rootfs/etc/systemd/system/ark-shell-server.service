[Unit]
Description=A.R.K. critical embodied desktop shell server
Requires=arkd.service ark-ui-broker.service
After=network.target arkd.service ark-ui-broker.service
PartOf=ark-desktop-core.target

[Service]
Type=simple
User=ark-desktop
Group=ark-state
WorkingDirectory=/usr/lib/arklinux-shell
Environment=NODE_ENV=production
Environment=ARK_SHELL_HOST=127.0.0.1
Environment=ARK_SHELL_PORT=3000
Environment=ARK_RUNTIME_URL=http://127.0.0.1:18080
Environment=ARK_UI_BROKER_URL=http://127.0.0.1:18082
ExecStart=/usr/bin/node /usr/lib/arklinux-shell/build/server.cjs
ExecStartPost=/usr/local/sbin/ark-desktop-ready --timeout 180
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/usr/lib/arklinux-shell /ark
MemoryMax=1G
CPUQuota=80%
TasksMax=256

[Install]
WantedBy=ark-desktop-core.target
