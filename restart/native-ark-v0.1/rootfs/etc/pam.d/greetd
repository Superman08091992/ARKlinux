#%PAM-1.0

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
account    include      system-local-login

# This must precede system-local-login's session stack so pam_systemd records
# the session as Wayland rather than tty. Do not read per-user PAM environment.
session    optional     pam_env.so conffile=/etc/greetd/greetd-pam-env.conf readenv=0 user_readenv=0
session    include      system-local-login
