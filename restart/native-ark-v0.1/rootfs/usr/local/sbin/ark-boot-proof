import copy
import json
import time
import urllib.error
import urllib.request

BASE = "http://127.0.0.1:18080"
TEXT = "ARKlinux complete Alatheia ingestion and real nomic embedding proof"
SOURCE_REF = "qemu-native-boot-proof:authorized-synthetic-control"


def emit(value):
    print(value, flush=True)


def request_json(path, payload=None, timeout=30, expected=(200,), attempts=1, delay=3):
    last = None
    for attempt in range(1, attempts + 1):
        data = None if payload is None else json.dumps(payload).encode("utf-8")
        request = urllib.request.Request(
            BASE + path,
            data=data,
            headers={"Content-Type": "application/json"} if data is not None else {},
            method="POST" if data is not None else "GET",
        )
        status = None
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                status = int(response.status)
                raw = response.read()
        except urllib.error.HTTPError as exc:
            status = int(exc.code)
            raw = exc.read()
        except OSError as exc:
            last = exc
            emit(
                f"ARK_HTTP_REQUEST_RETRY path={path} attempt={attempt}/{attempts} "
                f"error={type(exc).__name__}:{exc}"
            )
            if attempt < attempts:
                time.sleep(delay)
                continue
            raise
        try:
            value = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise RuntimeError(
                f"{path}: invalid JSON status={status} bytes={len(raw)} error={exc}"
            ) from exc
        if status in expected:
            return status, value
        last = RuntimeError(f"{path}: status={status} response={value!r}")
        emit(
            f"ARK_HTTP_REQUEST_RETRY path={path} attempt={attempt}/{attempts} "
            f"status={status} response={value!r}"
        )
        if attempt < attempts:
            time.sleep(delay)
    raise last


def require(condition, detail):
    if not condition:
        raise RuntimeError(detail)


last = None
for _attempt in range(60):
    try:
        _status, ingestion_status = request_json("/ingestion/status", timeout=5)
        if ingestion_status.get("ok") is True and ingestion_status.get("record_count", 0) >= 2:
