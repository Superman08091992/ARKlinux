#!/usr/bin/env bash
set -euo pipefail

fail(){
  printf 'ARK_NATIVE_BOOT_PROOF=FAIL detail=%q\n' "$*" >&2
  exit 1
}

diagnose_unit(){
  local unit="$1"
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_BEGIN unit=%s\n' "$unit" >&2
  systemctl --no-pager --full status "$unit" >&2 || true
  journalctl -b --no-pager -n 80 -u "$unit" >&2 || true
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_END unit=%s\n' "$unit" >&2
}

wait_active(){
  local unit="$1"
  local attempt
  for attempt in {1..30}; do
    systemctl is-active --quiet "$unit" && return 0
    sleep 1
  done
  diagnose_unit "$unit"
  fail "inactive:$unit"
}

for mp in / /ark/memory /ark/evidence /ark/state /ark/kj /ark/graveyard /ark/models /ark/checkpoints /ark/quarantine /ark/storage; do
  mountpoint -q "$mp" || fail "missing_mount:$mp"
done

[[ -d /ark/runtime ]] || fail 'missing:/ark/runtime'
[[ -L /opt/ark && "$(readlink /opt/ark)" == /ark ]] || fail 'invalid:/opt/ark_compatibility_symlink'

for unit in ark-kj.service ark-agent@kyle.service ark-agent@aletheia.service ark-agent@joey.service ark-agent@hrm.service ark-agent@kenny.service arkd.service ark-local-api.service; do
  wait_active "$unit"
done

python - <<'PY' || fail 'status_probe_failed'
import json
import time
import urllib.error
import urllib.request

last_error = None
for _attempt in range(30):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8081/status', timeout=5) as response:
            value = json.loads(response.read().decode())
        if not isinstance(value, dict):
            raise ValueError('status_not_object')
        print('ARK_STATUS_PROBE=PASS')
        break
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        last_error = exc
        time.sleep(1)
else:
    raise SystemExit(f'status_probe_not_ready:{last_error}')
PY

mkdir -p /var/lib/ark
cat > /var/lib/ark/boot-proof.json <<EOF
{"ok":true,"architecture":"native-ark-v0.1","root_subvolume":"@ark","canonical_root":"/ark"}
EOF
printf 'ARK_NATIVE_BOOT_PROOF=PASS\n'
