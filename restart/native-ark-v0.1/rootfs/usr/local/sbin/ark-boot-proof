#!/usr/bin/env bash
set -euo pipefail

fail(){
  printf 'ARK_NATIVE_BOOT_PROOF=FAIL detail=%q\n' "$*" >&2
  exit 1
}

diagnose_unit(){
  local unit="$1"
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_BEGIN unit=%s\n' "$unit" >&2
  systemctl --no-pager --full status "$unit" >&2 || true
  journalctl -b --no-pager -n 80 -u "$unit" >&2 || true
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_END unit=%s\n' "$unit" >&2
}

diagnose_runtime_stack(){
  local unit
  for unit in systemd-tmpfiles-setup.service ark-kj.service ark-agent@kyle.service ark-agent@aletheia.service ark-agent@joey.service ark-agent@hrm.service ark-agent@kenny.service arkd.service; do
    diagnose_unit "$unit"
  done
}

wait_active(){
  local unit="$1"
  local attempt
  for attempt in {1..30}; do
    systemctl is-active --quiet "$unit" && return 0
    sleep 1
  done
  diagnose_unit "$unit"
  fail "inactive:$unit"
}

ROOT_CONTRACT="$(stat -c '%U:%G:%a' /)"
[[ "$ROOT_CONTRACT" == "root:root:755" || "$ROOT_CONTRACT" == "root:root:555" ]] || {
  diagnose_unit systemd-tmpfiles-setup.service
  fail "invalid_root_contract:$ROOT_CONTRACT"
}
for runtime_path in /run/ark /run/ark/agents /run/ark/agents/kyle /run/ark/agents/aletheia /run/ark/agents/joey /run/ark/agents/hrm /run/ark/agents/kenny /run/ark/kj; do
  [[ -d "$runtime_path" ]] || {
    diagnose_unit systemd-tmpfiles-setup.service
    fail "missing_volatile_runtime_path:$runtime_path"
  }
done

for mp in / /ark/memory /ark/evidence /ark/state /ark/kj /ark/graveyard /ark/models /ark/checkpoints /ark/quarantine /ark/storage; do
  mountpoint -q "$mp" || fail "missing_mount:$mp"
done

[[ -d /ark/runtime ]] || fail 'missing:/ark/runtime'
[[ -L /opt/ark && "$(readlink /opt/ark)" == /ark ]] || fail 'invalid:/opt/ark_compatibility_symlink'

for unit in ollama.service ark-embedding-model.service ark-kj.service ark-agent@kyle.service ark-agent@aletheia.service ark-agent@joey.service ark-agent@hrm.service ark-agent@kenny.service arkd.service ark-local-api.service; do
  wait_active "$unit"
done

python - <<'PY' || fail 'status_probe_failed'
import json
import time
import urllib.error
import urllib.request

last_error = None
for _attempt in range(30):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8081/status', timeout=5) as response:
            value = json.loads(response.read().decode())
        if not isinstance(value, dict):
            raise ValueError('status_not_object')
        print('ARK_STATUS_PROBE=PASS')
        break
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        last_error = exc
        time.sleep(1)
else:
    raise SystemExit(f'status_probe_not_ready:{last_error}')
PY


if ! python - <<'PY'
import json
import time
import urllib.error
import urllib.request

BASE = "http://127.0.0.1:18080"

def request_json(path, payload=None, timeout=30):
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        BASE + path,
        data=data,
        headers={"Content-Type": "application/json"} if data is not None else {},
        method="POST" if data is not None else "GET",
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))

last_error = None
for _attempt in range(60):
    try:
        status = request_json("/graveyard/vector/status")
        if status.get("ok") is True:
            break
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        last_error = exc
    time.sleep(1)
else:
    raise SystemExit(f"runtime_vector_api_not_ready:{last_error}")

record = {
    "schema_version": "1.0",
    "graveyard_id": "gy:qemu:nomic-embed-text:768:v1",
    "type": "verified_fact",
    "fact": {"text": "ARKlinux real nomic embedding proof"},
    "verification": {"state": "verified"},
    "provenance": {"source": "qemu-native-boot-proof"},
}
sealed = request_json("/graveyard/vector/seal", record, timeout=240)
embedding = sealed.get("embedding") or {}
artifact = ((sealed.get("result") or {}).get("derived") or {}).get("embeddings", {}).get("ark-semantic-v1", {})
vector = artifact.get("vector") or []
model = embedding.get("model") or {}
if embedding.get("dimension") != 768 or len(vector) != 768:
    raise SystemExit("real_embedding_dimension_mismatch")
if model.get("name") != "nomic-embed-text:latest" or not model.get("digest"):
    raise SystemExit("real_embedding_model_identity_missing")
searched = request_json(
    "/graveyard/vector/search",
    {"query": "ARKlinux real nomic embedding proof", "top_k": 1},
    timeout=240,
)
matches = searched.get("matches") or []
if not matches or matches[0].get("graveyard_id") != record["graveyard_id"]:
    raise SystemExit("real_embedding_search_miss")
if matches[0].get("association_only") is not True:
    raise SystemExit("real_embedding_association_boundary_missing")
print(
    "ARK_REAL_EMBEDDING_PROBE=PASS "
    f"model={model['name']} digest={model['digest']} dimension={embedding['dimension']}"
)
PY
then
  diagnose_runtime_stack
  fail 'real_embedding_probe_failed'
fi

mkdir -p /var/lib/ark
cat > /var/lib/ark/boot-proof.json <<EOF
{"ok":true,"architecture":"native-ark-v0.1","root_subvolume":"@ark","canonical_root":"/ark"}
EOF
printf 'ARK_NATIVE_BOOT_PROOF=PASS\n'
