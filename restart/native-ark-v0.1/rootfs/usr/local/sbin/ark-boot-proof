#!/usr/bin/env bash
set -euo pipefail

fail(){
  printf 'ARK_NATIVE_BOOT_PROOF=FAIL detail=%q\n' "$*" >&2
  exit 1
}

diagnose_unit(){
  local unit="$1"
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_BEGIN unit=%s\n' "$unit" >&2
  systemctl --no-pager --full status "$unit" >&2 || true
  journalctl -b --no-pager -n 80 -u "$unit" >&2 || true
  printf 'ARK_NATIVE_UNIT_DIAGNOSTIC_END unit=%s\n' "$unit" >&2
}

diagnose_runtime_stack(){
  local unit
  for unit in systemd-tmpfiles-setup.service ollama.service ark-embedding-model.service ark-kj.service ark-agent@kyle.service ark-agent@aletheia.service ark-agent@joey.service ark-agent@hrm.service ark-agent@kenny.service arkd.service; do
    diagnose_unit "$unit"
  done
}

wait_active(){
  local unit="$1"
  local _attempt
  for _attempt in {1..30}; do
    systemctl is-active --quiet "$unit" && return 0
    sleep 1
  done
  diagnose_unit "$unit"
  fail "inactive:$unit"
}

agent_socket_responds(){
  local role="$1"
  local socket_path="$2"
  /usr/bin/runuser -u "ark-$role" -- /usr/bin/python - "$socket_path" "$role" <<'PY'
import json
import socket
import sys

socket_path, role = sys.argv[1:]
operation = "__ark_boot_readiness_probe__"
request = {"operation": operation, "payload": {}}
client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.settimeout(2.0)
try:
    client.connect(socket_path)
    client.sendall(
        json.dumps(request, sort_keys=True, separators=(",", ":")).encode("utf-8")
        + b"\n"
    )
    data = b""
    while b"\n" not in data and len(data) <= 65536:
        chunk = client.recv(65536)
        if not chunk:
            break
        data += chunk
finally:
    client.close()
if len(data) > 65536 or b"\n" not in data:
    raise SystemExit("agent readiness response is incomplete")
response = json.loads(data.split(b"\n", 1)[0].decode("utf-8"))
expected_error = f"operation {operation!r} is not allowed for role {role!r}"
if response != {
    "ok": False,
    "ipc_error": True,
    "error": expected_error,
}:
    raise SystemExit("agent readiness response is invalid")
PY
}

wait_agent_ready(){
  local role="$1"
  local unit="ark-agent@$1.service"
  local domain="/ark/agents/$1"
  local public_key="/ark/agent-public-keys/$1/signing-key.json"
  local socket="/run/ark/agents/$1/$1.sock"
  local _attempt
  for _attempt in {1..30}; do
    if systemctl is-active --quiet "$unit" &&
       [[ -s "$domain/private/signing-key.pem" ]] &&
       [[ -s "$public_key" ]] &&
       [[ -S "$socket" ]] &&
       agent_socket_responds "$role" "$socket"; then
      return 0
    fi
    sleep 1
  done
  diagnose_unit "$unit"
  fail "agent_identity_not_ready:$role"
}

ROOT_CONTRACT="$(stat -c '%U:%G:%a' /)"
[[ "$ROOT_CONTRACT" == "root:root:755" || "$ROOT_CONTRACT" == "root:root:555" ]] || {
  diagnose_unit systemd-tmpfiles-setup.service
  fail "invalid_root_contract:$ROOT_CONTRACT"
}
for runtime_path in /run/ark /run/ark/agents /run/ark/agents/kyle /run/ark/agents/aletheia /run/ark/agents/joey /run/ark/agents/hrm /run/ark/agents/kenny /run/ark/kj; do
  [[ -d "$runtime_path" ]] || {
    diagnose_unit systemd-tmpfiles-setup.service
    fail "missing_volatile_runtime_path:$runtime_path"
  }
done

for mp in / /ark/memory /ark/evidence /ark/state /ark/kj /ark/graveyard /ark/models /ark/checkpoints /ark/quarantine /ark/storage /ark/agents/kyle /ark/agents/aletheia /ark/agents/joey /ark/agents/hrm /ark/agents/kenny; do
  mountpoint -q "$mp" || fail "missing_mount:$mp"
done

[[ -d /ark/runtime ]] || fail 'missing:/ark/runtime'
[[ -f /ark/pair_mvp/pipeline.py && -f /ark/pair_mvp/alatheia.py ]] || fail 'missing:pinned_alatheia_runtime'
[[ -f /etc/ark/ARK_GENESIS_COMMIT && -f /etc/ark/ALATHEIA_COMMIT ]] || fail 'missing:source_provenance'
[[ ! -e /opt/ark && ! -L /opt/ark ]] || fail 'obsolete:/opt/ark'
[[ -x /usr/local/sbin/ark-model-pull ]] || fail 'missing:ark-model-pull'
[[ -r /usr/share/ark/model-catalog.json ]] || fail 'missing:model-catalog'
[[ "$(stat -c '%U:%G:%a' /ark/models)" == 'root:ark-state:750' ]] || fail 'invalid:model-root-contract'
[[ "$(stat -c '%U:%G:%a' /ark/models/ollama)" == 'ollama:ollama:750' ]] || fail 'invalid:ollama-model-store-contract'
id -nG ollama | tr ' ' '\n' | grep -qx ark-state || fail 'invalid:ollama-model-store-membership'

python - <<'PY' || fail 'invalid:model-catalog-contract'
import json
from pathlib import Path

catalog = json.loads(Path('/usr/share/ark/model-catalog.json').read_text(encoding='utf-8'))
if catalog.get('schema_version') != '1.0':
    raise SystemExit('unsupported catalog schema')
if catalog.get('provider') != 'ollama' or catalog.get('storage_path') != '/ark/models/ollama':
    raise SystemExit('invalid catalog provider or storage path')
models = {item['name']: item for item in catalog.get('models', [])}
if not models:
    raise SystemExit('catalog has no models')
for name, model in models.items():
    if (
        model.get('route_state') != 'available'
        or model.get('runtime_state') != 'paused'
        or model.get('activation') != 'on_demand'
        or model.get('preload') is not False
        or model.get('keep_alive') != 0
    ):
        raise SystemExit(f'model is not paused/on-demand: {name}')
for role, route in catalog.get('routes', {}).items():
    if route.get('primary') not in models:
        raise SystemExit(f'route references unknown primary: {role}')
    if any(name not in models for name in route.get('alternatives', [])):
        raise SystemExit(f'route references unknown alternative: {role}')
print('ARK_MODEL_CATALOG_PROBE=PASS state=available runtime=paused')
PY

ARK_GENESIS_COMMIT="$(tr -d '\r\n' < /etc/ark/ARK_GENESIS_COMMIT)"
ALATHEIA_COMMIT="$(tr -d '\r\n' < /etc/ark/ALATHEIA_COMMIT)"
[[ "$ARK_GENESIS_COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail 'invalid:ARK_GENESIS_COMMIT'
[[ "$ALATHEIA_COMMIT" =~ ^[0-9a-f]{40}$ ]] || fail 'invalid:ALATHEIA_COMMIT'
printf 'ARK_SOURCE_PROVENANCE_PROBE=PASS ark_genesis=%s alatheia=%s\n' "$ARK_GENESIS_COMMIT" "$ALATHEIA_COMMIT"

for unit in ollama.service ark-embedding-model.service ark-kj.service ark-agent@kyle.service ark-agent@aletheia.service ark-agent@joey.service ark-agent@hrm.service ark-agent@kenny.service arkd.service ark-local-api.service; do
  wait_active "$unit"
done
wait_active ark-batch-executor.socket
[[ -S /run/ark/batch-executor.sock ]] || fail 'missing_batch_executor_socket'
[[ "$(stat -c '%U:%G:%a' /var/lib/ark/batch-executor/claims)" == 'root:root:700' ]] || fail 'invalid_batch_claim_store'

declare -A AGENT_KEY_ID_OWNERS=()
for role in kyle aletheia joey hrm kenny; do
  wait_agent_ready "$role"
  printf 'ARK_AGENT_SOCKET_PROBE=PASS role=%s\n' "$role"
  domain="/ark/agents/$role"
  [[ "$(stat -c '%U:%G:%a' "$domain")" == "ark-$role:ark-agent-audit:750" ]] || fail "invalid_agent_domain:$role"
  [[ "$(stat -c '%U:%G:%a' "$domain/ledger")" == "ark-$role:ark-agent-audit:2750" ]] || fail "invalid_agent_ledger:$role"
  [[ -s "$domain/private/signing-key.pem" ]] || fail "missing_agent_private_key:$role"
  [[ "$(stat -c '%U:%G:%a' "$domain/private")" == "ark-$role:ark-$role-ipc:700" ]] || fail "invalid_agent_private_directory:$role"
  [[ "$(stat -c '%U:%a' "$domain/private/signing-key.pem")" == "ark-$role:600" ]] || fail "invalid_agent_private_key:$role"
  [[ -s "/ark/agent-public-keys/$role/signing-key.json" ]] || fail "missing_agent_public_key:$role"
  [[ "$(stat -c '%U:%a' "/ark/agent-public-keys/$role/signing-key.json")" == "ark-$role:644" ]] ||
    fail "invalid_agent_public_key:$role"
  if ! identity_marker="$(
    /usr/bin/runuser -u "ark-$role" -- /usr/bin/python - "$role" <<'PY'
import base64
import hashlib
import json
import sys
from pathlib import Path

from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

role = sys.argv[1]
private_path = Path(f"/ark/agents/{role}/private/signing-key.pem")
public_path = Path(f"/ark/agent-public-keys/{role}/signing-key.json")
private_key = serialization.load_pem_private_key(private_path.read_bytes(), password=None)
if not isinstance(private_key, Ed25519PrivateKey):
    raise SystemExit("private key is not Ed25519")
public_key = private_key.public_key()
raw_public = public_key.public_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PublicFormat.Raw,
)
expected = {
    "role": role,
    "algorithm": "ed25519",
    "key_id": "ed25519:" + hashlib.sha256(raw_public).hexdigest()[:32],
    "public_key": base64.b64encode(raw_public).decode("ascii"),
}
observed = json.loads(public_path.read_text(encoding="utf-8"))
if observed != expected:
    raise SystemExit("public record does not match private identity")
challenge = f"ARK-NATIVE-BOOT-IDENTITY-PROBE:{role}".encode("utf-8")
signature = private_key.sign(challenge)
public_key.verify(signature, challenge)
print(f"ARK_AGENT_IDENTITY_PROBE=PASS role={role} key_id={expected['key_id']}")
PY
  )"; then
    fail "invalid_agent_identity:$role"
  fi
  [[ "$identity_marker" =~ ^ARK_AGENT_IDENTITY_PROBE=PASS\ role=$role\ key_id=(ed25519:[0-9a-f]{32})$ ]] ||
    fail "invalid_agent_identity_marker:$role"
  key_id="${BASH_REMATCH[1]}"
  prior_role="${AGENT_KEY_ID_OWNERS[$key_id]:-}"
  [[ -z "$prior_role" ]] || fail "duplicate_agent_key_id:$role:$prior_role:$key_id"
  AGENT_KEY_ID_OWNERS["$key_id"]="$role"
  printf '%s\n' "$identity_marker"
done
printf 'ARK_AGENT_IDENTITY_SET_PROBE=PASS roles=5 unique_key_ids=5\n'

peer_pairs=0
for reader in kyle aletheia joey hrm kenny; do
  for owner in kyle aletheia joey hrm kenny; do
    [[ "$reader" == "$owner" ]] && continue
    /usr/bin/runuser -u "ark-$reader" -- /usr/bin/test ! -r "/ark/agents/$owner/private/signing-key.pem" ||
      fail "peer_private_key_readable:$reader:$owner"
    /usr/bin/runuser -u "ark-$reader" -- /usr/bin/test -r "/ark/agents/$owner/ledger" ||
      fail "peer_ledger_unreadable:$reader:$owner"
    /usr/bin/runuser -u "ark-$reader" -- /usr/bin/test -x "/ark/agents/$owner/ledger" ||
      fail "peer_ledger_unsearchable:$reader:$owner"
    /usr/bin/runuser -u "ark-$reader" -- /usr/bin/test ! -w "/ark/agents/$owner/ledger" ||
      fail "peer_ledger_writable:$reader:$owner"
    ((peer_pairs += 1))
  done
done
[[ "$peer_pairs" -eq 20 ]] || fail "invalid_peer_access_pair_count:$peer_pairs"
printf 'ARK_AGENT_CROSS_ROLE_ACCESS_PROBE=PASS private=isolated peer_ledgers=read_only pairs=%s\n' "$peer_pairs"

python - <<'PY' || fail 'status_probe_failed'
import json
import time
import urllib.error
import urllib.request

last_error = None
for _attempt in range(30):
    try:
        with urllib.request.urlopen('http://127.0.0.1:8081/status', timeout=5) as response:
            value = json.loads(response.read().decode())
        if not isinstance(value, dict):
            raise ValueError('status_not_object')
        print('ARK_STATUS_PROBE=PASS')
        break
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        last_error = exc
        time.sleep(1)
else:
    raise SystemExit(f'status_probe_not_ready:{last_error}')
PY


if ! python - <<'PY'
import copy
import json
import sys
import time
import urllib.error
import urllib.request

BASE = "http://127.0.0.1:18080"
TEXT = "ARKlinux complete Alatheia ingestion and real nomic embedding proof"
SOURCE_REF = "qemu-native-boot-proof:authorized-synthetic-control"


def emit(value):
    print(value, flush=True)


def request_json(path, payload=None, timeout=30, expected=(200,)):
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        BASE + path,
        data=data,
        headers={"Content-Type": "application/json"} if data is not None else {},
        method="POST" if data is not None else "GET",
    )
    status = None
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status = int(response.status)
            raw = response.read()
    except urllib.error.HTTPError as exc:
        status = int(exc.code)
        raw = exc.read()
    try:
        value = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(
            f"{path}: invalid JSON status={status} bytes={len(raw)} error={exc}"
        ) from exc
    if status not in expected:
        emit(
            "ARK_HTTP_REQUEST_FAILURE "
            f"path={path} status={status} expected={expected} response={value!r}"
        )
        raise RuntimeError(f"{path}: unexpected HTTP status {status}")
    return status, value


def require(condition, detail):
    if not condition:
        raise RuntimeError(detail)


def wait_runtime():
    last_error = None
    for _attempt in range(60):
        try:
            _status, value = request_json("/health", timeout=5)
            if value.get("ok") is True:
                return
        except Exception as exc:
            last_error = exc
        time.sleep(1)
    raise RuntimeError(f"runtime_not_ready:{last_error}")


wait_runtime()
emit("ARK_INGESTION_STAGE=AUTHORIZED_EVIDENCE")
_status, intake_evidence = request_json(
    "/evidence/write",
    {
        "kind": "native_boot_authorized_intake",
        "subject_ref": SOURCE_REF,
        "correlation_id": "corr:qemu-native-ingestion-proof",
        "payload": {
            "text": TEXT,
            "source": "qemu-native-boot-proof",
            "source_ref": SOURCE_REF,
            "synthetic_control": True,
            "consent_scope": ["ingest", "classify", "verify", "local_store"],
        },
    },
)
intake_evidence_ref = str(intake_evidence.get("evidence_ref") or "")
require(intake_evidence_ref, "intake_evidence_ref_missing")

emit("ARK_INGESTION_STAGE=KYLE_ACQUISITION")
_status, kyle = request_json(
    "/agents/kyle/run",
    {"raw_input": TEXT, "source": "qemu-native-boot-proof"},
)
kyle_result = kyle.get("result") or {}
kyle_ref = str(kyle_result.get("kyle_ref") or "")
require(kyle.get("ok") is True and kyle_ref.startswith("kyle:"), "kyle_acquisition_invalid")

emit("ARK_INGESTION_STAGE=QUARANTINE_EXTRACT_DEDUPE")
_status, submitted = request_json(
    "/ingestion/submit",
    {
        "content": TEXT,
        "source": "qemu-native-boot-proof",
        "source_type": "text",
        "source_ref": SOURCE_REF,
        "domain": "system",
        "privacy_scope": "local_only",
        "retention": "compress",
        "consent_scope": ["ingest", "classify", "verify", "local_store"],
        "kyle_ref": kyle_ref,
        "authority_ref": "operator:native-boot-proof",
        "evidence_refs": [intake_evidence_ref],
        "correlation_id": "corr:qemu-native-ingestion-proof",
        "metadata": {"synthetic_control": True, "purpose": "native-image-acceptance"},
    },
    timeout=30,
    expected=(201,),
)
ingestion = submitted.get("ingestion") or {}
record = ingestion.get("record") or {}
record_id = str(record.get("record_id") or "")
expected_preverification = ["raw", "quarantine", "extracted", "deduplicated", "review"]
actual_preverification = [
    item.get("to_state") for item in ingestion.get("transitions") or []
]
require(record_id.startswith("ingest:"), "ingestion_record_id_invalid")
require(record.get("state") == "review", "ingestion_did_not_stop_at_review")
require(actual_preverification == expected_preverification, "ingestion_transition_sequence_invalid")
require(bool(ingestion.get("units")), "ingestion_extraction_missing")
require((ingestion.get("integrity") or {}).get("ok") is True, "ingestion_integrity_invalid")
alatheia_report = ingestion.get("alatheia_report") or {}
require(
    any(
        item.get("stage") == "alatheia" and item.get("ok") is True
        for item in alatheia_report.get("audit") or []
        if isinstance(item, dict)
    ),
    "pinned_alatheia_report_missing",
)
emit(f"ARK_INGESTION_PREVERIFICATION_PROBE=PASS record={record_id}")

emit("ARK_INGESTION_STAGE=DEDUPLICATION_REJECTION")
_status, duplicate_response = request_json(
    "/ingestion/submit",
    {
        "content": TEXT,
        "source": "qemu-native-boot-proof",
        "source_type": "text",
        "source_ref": SOURCE_REF + ":duplicate",
        "domain": "system",
        "privacy_scope": "local_only",
        "retention": "compress",
        "consent_scope": ["ingest", "classify", "verify", "local_store"],
        "kyle_ref": kyle_ref,
        "authority_ref": "operator:native-boot-proof",
        "evidence_refs": [intake_evidence_ref],
        "correlation_id": "corr:qemu-native-ingestion-proof-duplicate",
        "metadata": {"synthetic_control": True, "purpose": "deduplication-negative-path"},
    },
    timeout=30,
    expected=(201,),
)
duplicate = duplicate_response.get("ingestion") or {}
require((duplicate.get("record") or {}).get("state") == "duplicate", "duplicate_not_rejected")
require(
    (duplicate.get("record") or {}).get("duplicate_of") == record_id,
    "duplicate_lineage_missing",
)
emit(f"ARK_INGESTION_DEDUPLICATION_PROBE=PASS duplicate_of={record_id}")

emit("ARK_INGESTION_STAGE=ALATHEIA_UNVERIFIED_REJECTION")
_status, unverified = request_json(
    "/agents/aletheia/adjudicate",
    {
        "candidate_claim": TEXT,
        "verification_state": "unverified",
        "verified_ref": None,
    },
    expected=(422,),
)
unverified_result = unverified.get("result") or {}
require(unverified.get("ok") is False, "unverified_alatheia_claim_was_accepted")
require(unverified_result.get("alatheia_ref") is None, "unverified_alatheia_ref_was_issued")
emit("ARK_ALATHEIA_REJECTION_PROBE=PASS state=unverified")

untrusted_graveyard = {
    "schema_version": "1.0",
    "graveyard_id": "gy:qemu:untrusted:must-fail:v1",
    "type": "verified_fact",
    "fact": {"text": TEXT},
    "verification": {
        "state": "verified",
        "verified_packet_ref": "evidence:forged",
        "alatheia_ref": "alatheia:forged",
    },
    "analysis": {"joey_plan_ref": "joey:forged"},
    "authorization": {"hrm_validation_ref": "hrm:forged"},
    "provenance": {
        "source": "qemu-native-boot-proof",
        "source_ref": SOURCE_REF,
        "ingestion_record_id": record_id,
        "content_sha256": record.get("content_sha256"),
    },
}
_status, rejected_seal = request_json(
    "/graveyard/vector/seal",
    untrusted_graveyard,
    timeout=15,
    expected=(400,),
)
require(rejected_seal.get("ok") is False, "untrusted_graveyard_record_was_admitted")
require(
    "trusted ingestion state" in str(rejected_seal.get("detail") or ""),
    "untrusted_graveyard_rejection_reason_missing",
)
emit("ARK_GRAVEYARD_REJECTION_PROBE=PASS reason=untrusted_ingestion")

emit("ARK_INGESTION_STAGE=VERIFICATION_EVIDENCE")
_status, verified_evidence = request_json(
    "/evidence/write",
    {
        "kind": "native_boot_verification_packet",
        "subject_ref": record_id,
        "correlation_id": "corr:qemu-native-ingestion-proof",
        "payload": {
            "record_id": record_id,
            "content_sha256": record.get("content_sha256"),
            "verification_state": "verified",
            "verification_method": "synthetic-control-digest-and-persistence-check",
            "source_ref": SOURCE_REF,
        },
    },
)
verified_packet_ref = str(verified_evidence.get("evidence_ref") or "")
require(verified_packet_ref, "verified_packet_ref_missing")

emit("ARK_INGESTION_STAGE=ALATHEIA_VERIFICATION")
_status, alatheia = request_json(
    "/agents/aletheia/adjudicate",
    {
        "candidate_claim": TEXT,
        "verification_state": "verified",
        "verified_ref": verified_packet_ref,
    },
)
alatheia_result = alatheia.get("result") or {}
alatheia_ref = str(
    alatheia_result.get("alatheia_ref")
    or alatheia_result.get("aletheia_ref")
    or ""
)
require(
    alatheia.get("ok") is True and alatheia_ref.startswith(("alatheia:", "aletheia:")),
    "alatheia_verification_invalid",
)
emit(f"ARK_ALATHEIA_VERIFICATION_PROBE=PASS ref={alatheia_ref}")

emit("ARK_INGESTION_STAGE=JOEY_ANALYSIS")
_status, joey = request_json(
    "/agents/joey/analyze",
    {"verified_packet_ref": verified_packet_ref, "statement": TEXT},
)
joey_plan_ref = str((joey.get("result") or {}).get("joey_plan_ref") or "")
require(joey.get("ok") is True and joey_plan_ref.startswith("joey:"), "joey_analysis_invalid")

emit("ARK_INGESTION_STAGE=HRM_VALIDATION")
_status, hrm = request_json(
    "/hrm/validate",
    {
        "joey_plan_ref": joey_plan_ref,
        "requested_action": "admit verified synthetic proof record to Graveyard",
        "evidence_refs": [intake_evidence_ref, verified_packet_ref],
        "policy_refs": ["authority:v2", "graveyard-admission:v1"],
        "risk": "low",
        "cid": "CID-NATIVE-INGESTION-PROOF",
        "human_approved": True,
    },
)
hrm_result = hrm.get("result") or {}
hrm_validation_ref = str(
    hrm_result.get("hrm_validation_ref")
    or hrm_result.get("hrm_sendoff_ref")
    or hrm_result.get("hrm_approval_ref")
    or ""
)
require(
    hrm.get("ok") is True and hrm_validation_ref.startswith("hrm:"),
    "hrm_validation_invalid",
)

emit("ARK_INGESTION_STAGE=TRUSTED_PROMOTION")
_status, promoted_response = request_json(
    "/ingestion/promote",
    {
        "record_id": record_id,
        "verified_packet_ref": verified_packet_ref,
        "alatheia_ref": alatheia_ref,
        "joey_plan_ref": joey_plan_ref,
        "hrm_validation_ref": hrm_validation_ref,
        "evidence_refs": [intake_evidence_ref, verified_packet_ref],
    },
)
promoted = promoted_response.get("ingestion") or {}
expected_complete = [
    "raw",
    "quarantine",
    "extracted",
    "deduplicated",
    "review",
    "verified",
    "analyzed",
    "authorized",
    "trusted",
]
require((promoted.get("record") or {}).get("state") == "trusted", "trusted_promotion_failed")
require(
    [item.get("to_state") for item in promoted.get("transitions") or []]
    == expected_complete,
    "complete_ingestion_transition_sequence_invalid",
)
require((promoted.get("integrity") or {}).get("ok") is True, "promoted_ingestion_integrity_invalid")
emit(f"ARK_INGESTION_PROBE=PASS record={record_id} transitions={len(expected_complete)}")

emit("ARK_INGESTION_STAGE=PERSISTENCE_RESTART")
request_json("/ingestion/status", timeout=10)
PY
then
  diagnose_runtime_stack
  fail 'ingestion_and_authority_probe_failed'
fi

