require((readback.get("integrity") or {}).get("ok") is True, "ingestion_integrity_failed_after_restart")
emit(f"ARK_INGESTION_PERSISTENCE_PROBE=PASS record={record_id}")

unverified = {
    "schema_version": "1.0",
    "graveyard_id": "gy:qemu:unverified:must-fail:v1",
    "type": "verified_fact",
    "fact": {"text": TEXT},
