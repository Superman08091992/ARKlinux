if ! python - <<'PY'
import json
import time
import urllib.error
import urllib.request

BASE = "http://127.0.0.1:18080"
TEXT = "ARKlinux complete Alatheia ingestion and real nomic embedding proof"
GRAVEYARD_ID = "gy:qemu:nomic-embed-text:768:ingestion:v1"


def emit(value):
    print(value, flush=True)


def request_json(path, payload=None, timeout=330, attempts=1):
    last = None
    for attempt in range(1, attempts + 1):
        data = None if payload is None else json.dumps(payload).encode("utf-8")
        request = urllib.request.Request(
            BASE + path,
            data=data,
            headers={"Content-Type": "application/json"} if data is not None else {},
            method="POST" if data is not None else "GET",
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")
            last = RuntimeError(f"{path}: HTTP {exc.code}: {body}")
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            last = exc
        emit(
            f"ARK_HTTP_REQUEST_RETRY path={path} attempt={attempt}/{attempts} "
            f"error={type(last).__name__}:{last}"
        )
        if attempt < attempts:
            time.sleep(5)
    raise last


for _attempt in range(60):
    try:
        health = request_json("/health", timeout=5, attempts=1)
        if health.get("ok") is True:
            break
    except Exception:
        time.sleep(1)
else:
    raise RuntimeError("runtime_after_graveyard_restart_not_ready")

emit("ARK_REAL_EMBEDDING_STAGE=SEARCH_REQUEST")
searched = request_json(
    "/graveyard/vector/search",
    {"query": TEXT, "top_k": 1},
    timeout=330,
    attempts=1,
)
matches = searched.get("matches") or []
if not matches or matches[0].get("graveyard_id") != GRAVEYARD_ID:
    raise RuntimeError("real_embedding_search_miss")
if matches[0].get("association_only") is not True:
    raise RuntimeError("real_embedding_association_boundary_missing")
model_name = str(matches[0].get("model") or "")
model_digest = str(matches[0].get("model_digest") or "")
dimension = int(matches[0].get("dimension") or 0)
if model_name != "nomic-embed-text:latest" or not model_digest or dimension != 768:
    raise RuntimeError("real_embedding_search_identity_invalid")
emit(
    "ARK_REAL_EMBEDDING_PROBE=PASS "
    f"model={model_name} digest={model_digest} dimension={dimension}"
)

events = request_json("/bus/events", timeout=15, attempts=1).get("events") or []
required_events = {
    "ingestion.persisted",
    "agent.kyle.completed",
    "agent.aletheia.completed",
    "agent.joey.completed",
    "hrm.validation.completed",
    "ingestion.trusted",
    "evidence.written",
}
present = {str(item.get("event_type") or "") for item in events}
missing = sorted(required_events - present)
if missing:
    raise RuntimeError(f"evidence_continuity_events_missing:{missing}")

outcomes = request_json("/outcomes", timeout=15, attempts=1)
if outcomes.get("chain_valid") is not True:
    raise RuntimeError(
        f"outcome_chain_invalid:{outcomes.get('chain_errors') or []}"
    )
if int(outcomes.get("record_count") or 0) < 1:
    raise RuntimeError("outcome_ledger_empty")
