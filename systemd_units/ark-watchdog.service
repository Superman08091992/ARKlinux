[Unit]
Description=ARK Watchdog - Evidence Chain Monitor
After=ark-core.service

[Service]
Type=simple
User=ark
Group=ark
ExecStart=/usr/bin/python /ark/agents/watchdog.py
Restart=always
RestartSec=10s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/ark/memory /ark/logs
ReadWritePaths=/ark/run

[Install]
WantedBy=ark.target
